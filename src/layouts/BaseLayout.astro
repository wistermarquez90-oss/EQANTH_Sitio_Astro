---
import '@fontsource-variable/montserrat';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { asset, baseUrl } from '../utils/paths';

interface Props {
  title: string;
  description: string;
  image?: string;
}
const { title, description, image = 'images/faces-exterior.webp' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(asset(image), Astro.site);
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#510000" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href={asset('images/isotipo-eqanth.png')} />
    <link rel="canonical" href={canonical} />
    <meta property="og:locale" content="es_VE" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="EQANTH" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    <script is:inline define:vars={{ baseUrl }}>
      document.documentElement.dataset.base = baseUrl;
    </script>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido"><slot /></main>
    <Footer />
  </body>
</html>
