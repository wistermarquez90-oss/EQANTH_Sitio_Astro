---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import GridGuides from '../components/GridGuides.astro';
import ArrowLink from '../components/ArrowLink.astro';
import { president, commissioners } from '../data/team';
import { asset } from '../utils/paths';
---
<BaseLayout title="Equipo actual | Directivos de EQANTH" description="Conoce a la presidenta y a las comisiones directivas de EQANTH por las carreras de FACES ULA.">
  <PageHero label="Equipo actual" intro="Las personas que coordinan EQANTH ayudan a que cada comisión tenga voz y a que el proyecto siga creciendo desde todas las carreras de FACES." image="images/comunidad-pasillos.webp" imageAlt="Estudiantes compartiendo en los espacios de FACES ULA" caption="Un proyecto coordinado por personas, construido entre muchas voces.">
    <Fragment slot="title">Las personas que hacen posible <span>EQANTH.</span></Fragment>
    <div class="hero-actions" slot="actions"><a class="button button-primary" href="#directivos">Conocer al equipo</a></div>
  </PageHero>

  <section class="section team-section" id="directivos" aria-labelledby="team-title">
    <div class="container">
      <div class="section-heading split">
        <div><p class="section-label">Dirección general</p><h2 class="section-title" id="team-title">Quiénes coordinan.</h2></div>
        <p class="section-intro">Estas fichas presentan a la presidencia y a los encargados de cada comisión. Los datos pendientes se incorporarán cuando el equipo los valide.</p>
      </div>

      <article class="president-card" id={president.id}>
        <div class="member-photo president-photo">
          {president.photo ? <img src={asset(president.photo)} alt={`Fotografía de ${president.name}`} loading="lazy" /> : <div class="photo-placeholder" role="img" aria-label="Fotografía de Mariana Parada pendiente"><strong aria-hidden="true">{president.initials}</strong><span>Fotografía pendiente</span></div>}
        </div>
        <div class="president-copy">
          <p class="section-label">Presidencia</p>
          <h3>{president.name}</h3>
          <p class="member-position">{president.position}</p>
          <p class="member-area">{president.area}</p>
          <p class="member-description">Coordina la dirección general del proyecto y el trabajo conjunto de las comisiones de las cinco carreras.</p>
        </div>
      </article>

      <div class="commission-heading"><p class="section-label">Representación por carrera</p><h3>Comisiones directivas</h3></div>
      <div class="commission-grid">
        {commissioners.map((member, index) => (
          <article class="member-card" id={member.id}>
            <div class="member-photo">
              {member.photo ? <img src={asset(member.photo)} alt={`Fotografía de ${member.name}`} loading="lazy" /> : <div class="photo-placeholder" role="img" aria-label={`Fotografía del encargado de ${member.area} pendiente`}><strong aria-hidden="true">{member.initials}</strong><span>Fotografía pendiente</span></div>}
            </div>
            <div class="member-copy">
              <span class="member-number">Comisión {String(index + 1).padStart(2, '0')}</span>
              <h3>{member.name ?? 'Nombre por confirmar'}</h3>
              <p class="member-position">{member.position}</p>
              <p class="member-area">{member.area}</p>
            </div>
          </article>
        ))}
      </div>
      <p class="team-note">Las iniciales identifican temporalmente cada ficha; no sustituyen las fotografías oficiales.</p>
    </div>
  </section>

  <section class="section section-blue join-section">
    <GridGuides />
    <div class="container join-inner">
      <div><p class="section-label">El relevo también forma parte del proyecto</p><h2 class="section-title">Hay más personas detrás de cada comisión.</h2></div>
      <div><p>Los directivos coordinan, pero EQANTH se sostiene con quienes investigan, producen, diseñan, conducen y comparten. Tú también puedes formar parte.</p><ArrowLink to="participa/?tipo=equipo#formulario" label="Quiero sumarme al equipo" /></div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero h1 span { color: var(--accent-primary); }
  .president-card { display: grid; border-top: 1px solid var(--border-subtle); border-bottom: 1px solid var(--border-subtle); }
  .member-photo { min-width: 0; aspect-ratio: 4 / 4.4; overflow: hidden; background: var(--surface-accent); }
  .member-photo img { width: 100%; height: 100%; object-fit: cover; }
  .photo-placeholder { width: 100%; height: 100%; display: grid; place-content: center; justify-items: center; gap: 14px; padding: 20px; color: var(--accent-secondary); text-align: center; }
  .photo-placeholder strong { font-size: clamp(3.5rem, 9vw, 7rem); line-height: 1; letter-spacing: -.07em; }
  .photo-placeholder span { color: var(--text-secondary); font-size: .66rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .president-copy { align-self: center; padding-block: 36px; }
  .president-copy h3 { margin: 16px 0 8px; font-size: clamp(2.2rem, 5vw, 5rem); line-height: 1; letter-spacing: -.06em; }
  .member-position { margin: 0 0 4px; color: var(--accent-primary); font-size: .88rem; font-weight: 760; }
  .member-area { margin: 0; color: var(--text-secondary); font-size: .82rem; }
  .member-description { max-width: 50ch; margin: 24px 0 0; color: var(--text-secondary); font-size: .9rem; line-height: 1.8; }
  .commission-heading { margin: clamp(56px, 8vw, 96px) 0 32px; }
  .commission-heading h3 { margin: 12px 0 0; font-size: clamp(1.8rem, 3vw, 2.8rem); letter-spacing: -.04em; }
  .commission-grid { display: grid; gap: 32px 20px; }
  .member-card { border-top: 1px solid var(--border-subtle); padding-top: 16px; }
  .member-copy { padding-block: 20px 4px; }
  .member-number { color: var(--accent-secondary); font-size: .62rem; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; }
  .member-copy h3 { margin: 12px 0 8px; font-size: 1.08rem; line-height: 1.3; }
  .team-note { margin: 32px 0 0; color: var(--text-tertiary); font-size: .7rem; }
  .join-inner { position: relative; z-index: 1; display: grid; gap: 32px; }
  .join-inner > div:last-child { align-self: end; }
  .join-inner > div:last-child p { max-width: 48ch; margin: 0 0 20px; color: var(--text-secondary); line-height: 1.8; }
  @media (min-width: 640px) { .commission-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 900px) {
    .president-card { grid-template-columns: minmax(280px, .75fr) 1.25fr; gap: clamp(40px, 7vw, 96px); padding-block: 24px; }
    .president-photo { max-height: 520px; }
    .commission-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 48px 24px; }
    .join-inner { grid-template-columns: 1.2fr .8fr; gap: 72px; }
  }
</style>
