---
import BaseLayout from '../layouts/BaseLayout.astro';
import GridGuides from '../components/GridGuides.astro';
import Icon from '../components/Icon.astro';
import ArrowLink from '../components/ArrowLink.astro';
import { asset } from '../utils/paths';

const quickLinks = [
  { icon: 'book', title: 'Necesito información académica', text: 'Guías, procesos y orientación útil.', path: 'guia/' },
  { icon: 'mic', title: 'Quiero escuchar el podcast', text: 'Conversaciones que también enseñan.', path: 'podcast/' },
  { icon: 'users', title: 'Quiero conocer una historia FACES', text: 'Las personas detrás de cada aula.', path: 'historias/' },
  { icon: 'heart', title: 'Quiero participar en EQANTH', text: 'Tu voz también forma parte.', path: 'participa/' }
];
const today = [
  { id: 'informarnos', tab: 'Informarnos', title: 'Hoy nos toca informarnos', text: 'Entender el proceso también es parte de la vida universitaria. Reúne guías, fechas y fuentes en un solo lugar.', label: 'Explora Tu guía FACES', path: 'guia/', image: 'images/faces-exterior.webp', alt: 'Fachada de la Facultad de Ciencias Económicas y Sociales' },
  { id: 'escuchar', tab: 'Escuchar', title: 'Hoy nos toca escuchar', text: 'Hay conversaciones que amplían la experiencia académica y nos ayudan a mirar FACES desde otra voz.', label: 'Conoce el podcast', path: 'podcast/', image: 'images/faces-pasillo.webp', alt: 'Pasillo interior de FACES ULA' },
  { id: 'conocer', tab: 'Conocer', title: 'Hoy nos toca conocer', text: 'Detrás de cada aula hay una historia, una trayectoria y una huella que merece ser preservada.', label: 'Descubre Historias FACES', path: 'historias/', image: 'images/docente-aula.webp', alt: 'Docente durante una clase en FACES ULA' },
  { id: 'participar', tab: 'Participar', title: 'Hoy nos toca participar', text: 'Esta historia no se construye con una sola voz. Suma una idea, una historia, un invitado o tu talento.', label: 'Quiero participar', path: 'participa/', image: 'images/comunidad-pasillos.webp', alt: 'Estudiantes en un pasillo de FACES ULA' }
];
const features = [
  { number: 'I', label: 'Tu guía FACES', title: 'La información útil no debería desaparecer.', text: 'Orientación académica y administrativa explicada con claridad, organizada por temas y acompañada de fecha y fuente. EQANTH orienta; las dependencias oficiales confirman.', path: 'guia/', link: 'Ir a la guía', image: 'images/faces-exterior.webp', alt: 'Exterior de FACES ULA' },
  { number: 'II', label: 'Historias FACES', title: 'Una Facultad también son las personas que la habitan.', text: 'Estudiantes, profesores, trabajadores, autoridades y egresados comparten experiencias, aprendizajes y proyectos. Un archivo humano para reconocernos y recordar.', path: 'historias/', link: 'Conocer las historias', image: 'images/trabajo-administrativo.webp', alt: 'Miembro del personal administrativo de FACES ULA' },
  { number: 'III', label: 'Podcast', title: 'Hay conversaciones que también enseñan.', text: 'Entrevistas de profundidad, cápsulas y coberturas para escuchar a la comunidad, debatir con respeto y acercar los temas que importan en FACES.', path: 'podcast/', link: 'Entrar al podcast', image: 'images/faces-pasillo.webp', alt: 'Arquitectura interior de FACES ULA' }
];
---
<BaseLayout title="EQANTH | Historia, pertenencia e identidad" description="Historias, información y voces para entender, vivir y sentir la Facultad de Ciencias Económicas y Sociales de la Universidad de Los Andes.">
  <section class="home-hero">
    <GridGuides />
    <div class="home-hero-inner">
      <div class="hero-heading">
        <p class="section-label">FACES · Universidad de Los Andes</p>
        <h1>¿En qué aula<br /><span>nos toca hoy?</span></h1>
      </div>
      <div class="hero-intro">
        <p>Historias, información y voces para entender, vivir y sentir <strong>nuestra Facultad.</strong></p>
        <div class="hero-actions">
          <a class="button button-primary" href={asset('guia/')}>Explora FACES <Icon name="arrow" size={18}/></a>
          <a class="button button-outline" href={asset('historias/')}>Conoce nuestras historias</a>
        </div>
      </div>
      <figure class="hero-photo">
        <img src={asset('images/faces-exterior.webp')} alt="Fachada de FACES ULA con el mensaje FACES consciente, espacio sustentable" width="1200" height="540" fetchpriority="high" />
        <figcaption><span>FACES ULA</span> Una comunidad, muchas formas de pertenecer.</figcaption>
      </figure>
      <aside class="hero-note">
        <span class="note-mark" aria-hidden="true">?</span>
        <p>Una Facultad también se construye con las historias que contamos, la información que compartimos y las personas que decidimos escuchar.</p>
      </aside>
    </div>
  </section>

  <section class="quick-section" aria-labelledby="quick-title">
    <div class="container">
      <div class="quick-heading"><h2 id="quick-title">¿Qué necesitas hoy?</h2><p>Ve directo a lo que buscas.</p></div>
      <div class="quick-grid">
        {quickLinks.map((item) => <a class="quick-link" href={asset(item.path)}>
          <Icon name={item.icon} size={25}/>
          <span><strong>{item.title}</strong><small>{item.text}</small></span>
          <Icon name="arrow" size={21} class="quick-arrow"/>
        </a>)}
      </div>
    </div>
  </section>

  <section class="section section-dark today-section" aria-labelledby="today-title">
    <GridGuides />
    <div class="container today-layout">
      <div class="today-intro">
        <p class="section-label">Una portada que cambia contigo</p>
        <h2 class="section-title" id="today-title">Hoy nos toca…</h2>
        <p>Elige una puerta de entrada. Cada una lleva a una forma distinta de vivir FACES.</p>
      </div>
      <div class="today-tabs" role="tablist" aria-label="Contenidos destacados">
        {today.map((item, index) => <button type="button" role="tab" id={`tab-${item.id}`} aria-controls={`panel-${item.id}`} aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1} data-tab={item.id}><span>0{index + 1}</span>{item.tab}<Icon name="arrow" size={19}/></button>)}
      </div>
      <div class="today-panels">
        {today.map((item, index) => <article role="tabpanel" id={`panel-${item.id}`} aria-labelledby={`tab-${item.id}`} hidden={index !== 0} data-panel={item.id}>
          <img src={asset(item.image)} alt={item.alt} width="1200" height="540" loading="lazy" />
          <div class="today-panel-copy"><h3>{item.title}</h3><p>{item.text}</p><ArrowLink to={item.path} label={item.label}/></div>
        </article>)}
      </div>
    </div>
  </section>

  <section class="section about-home">
    <div class="container about-home-grid">
      <div><p class="section-label">Somos EQANTH</p><h2 class="section-title">Nacimos de una pregunta cotidiana.</h2></div>
      <div class="about-home-copy"><p>Somos una plataforma nacida en FACES ULA para acercar información, contar las historias de nuestra comunidad y recordarnos que la experiencia universitaria también se construye en las conversaciones, los encuentros y las personas.</p><ArrowLink to="somos/" label="Conoce por qué existimos"/></div>
    </div>
  </section>

  <section class="section section-muted feature-section" aria-labelledby="explore-title">
    <div class="container">
      <div class="section-heading split"><div><p class="section-label">El ecosistema EQANTH</p><h2 class="section-title" id="explore-title">Tres formas de entrar a FACES.</h2></div><p class="section-intro">Información para orientarte. Historias para reconocerte. Conversaciones para quedarte.</p></div>
      <div class="feature-list">
        {features.map((feature, index) => <article class:list={["feature-row", { reverse: index % 2 === 1 }]}>
          <figure class="feature-image"><img src={asset(feature.image)} alt={feature.alt} width="1200" height="540" loading="lazy" /></figure>
          <div class="feature-copy"><span class="feature-number">{feature.number}.</span><p class="section-label">{feature.label}</p><h3>{feature.title}</h3><p>{feature.text}</p><ArrowLink to={feature.path} label={feature.link}/></div>
        </article>)}
      </div>
    </div>
  </section>

  <section class="section community-cta">
    <GridGuides />
    <div class="container community-cta-inner">
      <p class="section-label">Aquí también hay un aula para ti</p>
      <h2>Esta historia no se construye<br />con una sola voz.</h2>
      <div><p>Si tienes algo que contar, proponer o aportar, tu voz puede formar parte de EQANTH.</p><a class="button button-primary" href={asset('participa/')}>Quiero aportar <Icon name="arrow" size={18}/></a></div>
    </div>
  </section>
</BaseLayout>

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-tab]'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-panel]'));
  function activateTab(id: string, focus = false) {
    tabs.forEach((tab) => {
      const active = tab.dataset.tab === id;
      tab.setAttribute('aria-selected', String(active));
      tab.tabIndex = active ? 0 : -1;
      if (active && focus) tab.focus();
    });
    panels.forEach((panel) => { panel.hidden = panel.dataset.panel !== id; });
  }
  tabs.forEach((tab, index) => {
    tab.addEventListener('click', () => activateTab(tab.dataset.tab || ''));
    tab.addEventListener('keydown', (event) => {
      if (!['ArrowRight', 'ArrowLeft', 'ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) return;
      event.preventDefault();
      let next = index;
      if (event.key === 'ArrowRight' || event.key === 'ArrowDown') next = (index + 1) % tabs.length;
      if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') next = (index - 1 + tabs.length) % tabs.length;
      if (event.key === 'Home') next = 0;
      if (event.key === 'End') next = tabs.length - 1;
      activateTab(tabs[next].dataset.tab || '', true);
    });
  });
</script>

<style>
  .home-hero { position: relative; overflow: hidden; }
  .home-hero-inner { position: relative; z-index: 1; width: min(100% - 32px, var(--container)); margin-inline: auto; padding-block: clamp(48px, 7vw, 88px) 0; display: grid; gap: 32px; }
  .hero-heading h1 { margin: 18px 0 0; max-width: 12ch; font-size: clamp(3.15rem, 9vw, 8.8rem); line-height: .9; letter-spacing: -.075em; }
  .hero-heading h1 span { color: var(--accent-primary); }
  .hero-intro { display: grid; gap: 24px; }
  .hero-intro > p { max-width: 48ch; margin: 0; color: var(--text-secondary); font-size: clamp(1rem, 2vw, 1.25rem); line-height: 1.65; }
  .hero-intro strong { color: var(--text-primary); }
  .hero-photo { position: relative; margin: 16px 0 0; min-height: 260px; overflow: hidden; background: var(--surface-muted); }
  .hero-photo img { width: 100%; height: 100%; min-height: 260px; object-fit: cover; }
  .hero-photo figcaption { position: absolute; left: 16px; bottom: 16px; max-width: calc(100% - 32px); padding: 10px 14px; background: var(--surface-page); color: var(--text-secondary); font-size: .65rem; }
  .hero-photo figcaption span { margin-right: 8px; color: var(--accent-primary); font-weight: 800; }
  .hero-note { position: relative; display: grid; align-content: space-between; gap: 32px; padding: 24px; background: var(--surface-accent); }
  .hero-note p { position: relative; margin: 0; font-size: .82rem; font-weight: 600; line-height: 1.75; }
  .note-mark { color: var(--accent-secondary); font-size: 4rem; font-weight: 800; line-height: 1; }
  .quick-section { padding-block: 48px; border-bottom: 1px solid var(--border-subtle); }
  .quick-heading { display: flex; align-items: end; justify-content: space-between; gap: 16px; margin-bottom: 24px; }
  .quick-heading h2 { margin: 0; font-size: 1.25rem; letter-spacing: -.025em; }
  .quick-heading p { display: none; margin: 0; color: var(--text-secondary); font-size: .75rem; }
  .quick-grid { display: grid; border-top: 1px solid var(--border-subtle); }
  .quick-link { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 16px; min-height: 104px; padding: 20px 0; border-bottom: 1px solid var(--border-subtle); color: var(--text-primary); text-decoration: none; transition: padding 180ms ease-out, color 180ms ease-out; }
  .quick-link > svg:first-child { color: var(--accent-primary); }
  .quick-link span { display: grid; gap: 4px; }
  .quick-link strong { font-size: .85rem; line-height: 1.4; }
  .quick-link small { color: var(--text-secondary); font-size: .7rem; line-height: 1.45; }
  .quick-arrow { color: var(--accent-primary); transition: transform 180ms ease-out; }
  .quick-link:hover { padding-inline: 8px; color: var(--accent-primary); }
  .quick-link:hover .quick-arrow { transform: translateX(5px); }
  .today-layout { position: relative; z-index: 1; display: grid; gap: 40px; }
  .today-intro > p:last-child { max-width: 44ch; margin: 24px 0 0; font-size: .88rem; opacity: .76; }
  .today-tabs { display: grid; grid-template-columns: repeat(2, 1fr); border-top: 1px solid var(--border-on-dark); }
  .today-tabs button { min-height: 56px; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 10px; padding: 12px; border: 0; border-bottom: 1px solid var(--border-on-dark); background: transparent; color: var(--text-on-dark); text-align: left; cursor: pointer; font-size: .75rem; font-weight: 700; transition: background 180ms ease-out, color 180ms ease-out; }
  .today-tabs button span { font-size: .58rem; opacity: .55; }
  .today-tabs button svg { opacity: 0; transition: opacity 180ms ease-out, transform 180ms ease-out; }
  .today-tabs button[aria-selected='true'] { background: var(--text-on-dark); color: var(--wine-900); }
  .today-tabs button[aria-selected='true'] svg { opacity: 1; }
  .today-tabs button:hover svg { opacity: 1; transform: translateX(3px); }
  .today-panels article { display: grid; }
  .today-panels article[hidden] { display: none; }
  .today-panels img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; }
  .today-panel-copy { padding-top: 24px; }
  .today-panel-copy h3 { margin: 0 0 16px; font-size: clamp(1.7rem, 4vw, 2.7rem); line-height: 1.1; letter-spacing: -.045em; }
  .today-panel-copy p { max-width: 48ch; margin: 0 0 16px; font-size: .85rem; line-height: 1.75; opacity: .8; }
  .about-home-grid { display: grid; gap: 32px; }
  .about-home-copy { max-width: 58ch; }
  .about-home-copy p { margin: 0 0 20px; color: var(--text-secondary); font-size: clamp(1rem, 2vw, 1.15rem); line-height: 1.8; }
  .feature-list { display: grid; gap: 64px; }
  .feature-row { display: grid; gap: 28px; }
  .feature-image { margin: 0; overflow: hidden; }
  .feature-image img { width: 100%; height: 100%; min-height: 260px; object-fit: cover; }
  .feature-copy { position: relative; align-self: center; }
  .feature-number { display: block; margin-bottom: 20px; color: var(--accent-secondary); font-size: .8rem; font-weight: 800; }
  .feature-copy h3 { max-width: 15ch; margin: 16px 0 20px; font-size: clamp(1.8rem, 4vw, 3.25rem); line-height: 1.08; letter-spacing: -.05em; }
  .feature-copy > p:not(.section-label) { max-width: 51ch; margin: 0 0 16px; color: var(--text-secondary); font-size: .88rem; line-height: 1.8; }
  .community-cta { position: relative; overflow: hidden; }
  .community-cta-inner { position: relative; z-index: 1; }
  .community-cta h2 { margin: 20px 0 32px; font-size: clamp(2.5rem, 7.5vw, 7rem); line-height: .98; letter-spacing: -.065em; }
  .community-cta-inner > div { display: grid; gap: 24px; }
  .community-cta-inner > div p { max-width: 47ch; margin: 0; color: var(--text-secondary); line-height: 1.75; }
  .community-cta .button { justify-self: start; }
  @media (min-width: 768px) {
    .home-hero-inner { width: min(100% - 48px, var(--container)); grid-template-columns: repeat(12, 1fr); column-gap: 24px; }
    .hero-heading { grid-column: 1 / -1; }
    .hero-intro { grid-column: 7 / -1; grid-template-columns: 1fr; padding-bottom: 16px; }
    .hero-photo { grid-column: 1 / span 8; height: 390px; margin-top: 24px; }
    .hero-note { grid-column: 9 / -1; margin-top: 24px; }
    .quick-heading p { display: block; }
    .quick-grid { grid-template-columns: repeat(2, 1fr); }
    .quick-link { padding-inline: 20px; }
    .quick-link:nth-child(odd) { border-right: 1px solid var(--border-subtle); }
    .today-layout { grid-template-columns: repeat(12, 1fr); column-gap: 24px; }
    .today-intro { grid-column: 1 / span 6; }
    .today-tabs { grid-column: 8 / -1; grid-row: 1; }
    .today-panels { grid-column: 1 / -1; }
    .today-panels article { grid-template-columns: 1.25fr .75fr; gap: 40px; align-items: center; }
    .about-home-grid { grid-template-columns: 1.15fr .85fr; gap: 64px; align-items: end; }
    .feature-row { grid-template-columns: 1.1fr .9fr; gap: 64px; }
    .feature-row.reverse .feature-image { order: 2; }
    .feature-row.reverse .feature-copy { order: 1; }
    .feature-image { height: 420px; }
    .community-cta-inner > div { grid-template-columns: 1fr auto; align-items: end; }
  }
  @media (min-width: 1100px) {
    .hero-heading h1 { font-size: clamp(6rem, 8.3vw, 8.8rem); }
    .hero-intro { grid-column: 8 / -1; }
    .quick-grid { grid-template-columns: repeat(4, 1fr); }
    .quick-link { min-height: 148px; grid-template-columns: 1fr auto; align-content: space-between; }
    .quick-link > svg:first-child { grid-column: 1 / -1; }
    .quick-link:nth-child(3) { border-right: 1px solid var(--border-subtle); }
    .quick-link small { max-width: 28ch; }
    .today-panels article { grid-template-columns: 1.4fr .6fr; }
  }
  @media (max-width: 480px) {
    .home-hero-inner { padding-top: 40px; }
    .hero-heading h1 { font-size: clamp(2.85rem, 14.5vw, 4.2rem); }
    .hero-photo { margin-inline: -16px; }
    .today-tabs { grid-template-columns: 1fr; }
  }
</style>
