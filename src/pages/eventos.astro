---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import GridGuides from '../components/GridGuides.astro';
import ArrowLink from '../components/ArrowLink.astro';
import Icon from '../components/Icon.astro';
import { events } from '../data/events';
---
<BaseLayout title="Eventos EQANTH | Agenda y participación FACES" description="Conoce los eventos que EQANTH realiza y en los que participa, incluyendo FACES FEST, próximas actividades y el archivo de encuentros.">
  <PageHero label="Agenda EQANTH" intro="Reunimos los eventos que organizamos y aquellos en los que participamos: próximas fechas, información útil y memoria de cada encuentro." image="images/faces-exterior.webp" imageAlt="Exterior de la Facultad de Ciencias Económicas y Sociales" caption="Lo que vivimos juntos también forma parte de nuestra historia.">
    <Fragment slot="title">Los eventos también nos hacen <span>comunidad.</span></Fragment>
    <div class="hero-actions" slot="actions"><a class="button button-primary" href="#agenda">Explorar la agenda</a></div>
  </PageHero>

  <section class="section section-dark events-section" id="agenda" aria-labelledby="events-title">
    <GridGuides />
    <div class="container events-inner">
      <div class="section-heading split">
        <div><p class="section-label">En nuestra agenda</p><h2 class="section-title" id="events-title">Próximos encuentros.</h2></div>
        <p class="section-intro">Publicaremos aquí los datos confirmados de cada evento. Por ahora, FACES FEST abre este espacio.</p>
      </div>
      {events.map((event, index) => (
        <article class="event-feature" id={event.slug}>
          <div class="event-poster" aria-hidden="true">
            <span>EQANTH presenta · {String(index + 1).padStart(2, '0')}</span>
            <strong>FACES<br /><em>FEST</em></strong>
            <small>Nuestra agenda comienza aquí</small>
          </div>
          <div class="event-copy">
            <span class="tag">{event.status}</span>
            <h3>{event.title}</h3>
            <p class="event-summary">{event.summary}</p>
            <dl class="event-details">
              <div><dt><Icon name="calendar" size={19} /> Cuándo</dt><dd>{event.date}</dd></div>
              <div><dt><Icon name="pin" size={19} /> Dónde</dt><dd>{event.location}</dd></div>
              <div><dt><Icon name="users" size={19} /> Participación</dt><dd>{event.participation}</dd></div>
            </dl>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section event-guide" aria-labelledby="event-guide-title">
    <div class="container">
      <div class="section-heading split">
        <div><p class="section-label">Una agenda que también preserva</p><h2 class="section-title" id="event-guide-title">Antes, durante y después.</h2></div>
        <p class="section-intro">Este apartado crecerá con cada actividad realizada por EQANTH o con nuestra participación.</p>
      </div>
      <div class="event-stages">
        <article><span>01</span><h3>Próximos eventos</h3><p>Fechas, lugares, actividades y orientaciones confirmadas para que sepas cómo participar.</p></article>
        <article><span>02</span><h3>Participaciones</h3><p>Encuentros e iniciativas de otras organizaciones en los que EQANTH esté presente.</p></article>
        <article><span>03</span><h3>Memoria de eventos</h3><p>Un archivo para recordar lo realizado, conservar sus materiales y reconocer a quienes lo hicieron posible.</p></article>
      </div>
      <div class="archive-empty"><p class="section-label">Archivo de eventos</p><h3>Todavía no hay eventos finalizados en este archivo.</h3><p>Cuando FACES FEST y las próximas actividades se realicen, podremos conservar aquí su memoria.</p></div>
    </div>
  </section>

  <section class="section section-blue event-cta">
    <div class="container event-cta-inner">
      <div><p class="section-label">Construyamos la próxima actividad</p><h2 class="section-title">¿Quieres colaborar en un evento?</h2></div>
      <ArrowLink to="participa/?tipo=alianza#formulario" label="Conversemos sobre una alianza" />
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero h1 span { color: var(--accent-primary); }
  .events-inner { position: relative; z-index: 1; }
  .event-feature { display: grid; scroll-margin-top: 100px; }
  .event-poster { min-height: 360px; display: flex; flex-direction: column; justify-content: space-between; padding: clamp(24px, 5vw, 56px); background: var(--surface-accent); color: var(--text-primary); }
  .event-poster > span { color: var(--accent-secondary); font-size: .66rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  .event-poster strong { color: var(--accent-primary); font-size: clamp(4rem, 11vw, 9rem); line-height: .72; letter-spacing: -.09em; }
  .event-poster em { color: var(--accent-secondary); font-style: normal; }
  .event-poster small { max-width: 24ch; color: var(--text-secondary); font-size: .7rem; font-weight: 650; }
  .event-copy { align-self: center; padding-block: 40px; }
  .event-copy .tag { color: var(--text-on-dark); border-color: var(--border-on-dark); }
  .event-copy h3 { margin: 20px 0; font-size: clamp(2.8rem, 7vw, 6.5rem); line-height: .95; letter-spacing: -.07em; }
  .event-summary { max-width: 52ch; margin: 0 0 32px; color: var(--text-on-dark); font-size: .95rem; line-height: 1.8; opacity: .8; }
  .event-details { margin: 0; border-top: 1px solid var(--border-on-dark); }
  .event-details > div { display: grid; gap: 6px; padding-block: 16px; border-bottom: 1px solid var(--border-on-dark); }
  .event-details dt { display: flex; align-items: center; gap: 10px; color: var(--accent-secondary-on-dark); font-size: .68rem; font-weight: 750; text-transform: uppercase; letter-spacing: .06em; }
  .event-details dd { margin: 0; font-size: .8rem; opacity: .78; }
  .event-stages { display: grid; border-top: 1px solid var(--border-subtle); }
  .event-stages article { padding-block: 28px; border-bottom: 1px solid var(--border-subtle); }
  .event-stages span { color: var(--accent-secondary); font-size: .65rem; font-weight: 800; }
  .event-stages h3 { margin: 12px 0 10px; font-size: 1.2rem; }
  .event-stages p { margin: 0; color: var(--text-secondary); font-size: .82rem; line-height: 1.75; }
  .archive-empty { margin-top: clamp(48px, 7vw, 88px); padding-top: 28px; border-top: 1px solid var(--border-subtle); }
  .archive-empty h3 { max-width: 30ch; margin: 16px 0 12px; font-size: clamp(1.4rem, 3vw, 2.2rem); line-height: 1.15; letter-spacing: -.035em; }
  .archive-empty > p:last-child { max-width: 60ch; margin: 0; color: var(--text-secondary); font-size: .85rem; }
  .event-cta-inner { display: grid; gap: 28px; align-items: end; }
  @media (min-width: 800px) {
    .event-feature { grid-template-columns: 1.1fr .9fr; gap: clamp(40px, 7vw, 96px); }
    .event-stages { grid-template-columns: repeat(3, 1fr); }
    .event-stages article { padding: 28px; border-right: 1px solid var(--border-subtle); }
    .event-stages article:first-child { padding-left: 0; }
    .event-stages article:last-child { padding-right: 0; border-right: 0; }
    .event-cta-inner { grid-template-columns: 1fr auto; }
  }
</style>
