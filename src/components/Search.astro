---
import Icon from './Icon.astro';
import { searchEntries } from '../data/site';
import { href } from '../utils/paths';
const entries = searchEntries.map((entry) => ({ ...entry, url: href(entry.path) }));
---
<dialog class="search-dialog" id="search-dialog" aria-labelledby="search-title" data-entries={JSON.stringify(entries)}>
  <div class="search-shell">
    <div class="search-top">
      <p id="search-title">¿Qué necesitas encontrar hoy?</p>
      <button class="search-close" type="button" data-close-search aria-label="Cerrar buscador"><Icon name="close" size={25}/></button>
    </div>
    <label class="search-field">
      <span class="sr-only">Buscar en EQANTH</span>
      <Icon name="search" size={26}/>
      <input id="site-search" type="search" placeholder="Escribe una guía, historia o tema…" autocomplete="off" />
    </label>
    <p class="search-hint" id="search-hint">Sugerencias para empezar</p>
    <div class="search-results" id="search-results" aria-live="polite"></div>
  </div>
</dialog>

<script>
  type SearchEntry = { title: string; category: string; description: string; url: string; keywords: string };
  const dialog = document.querySelector<HTMLDialogElement>('#search-dialog');
  const input = document.querySelector<HTMLInputElement>('#site-search');
  const results = document.querySelector<HTMLElement>('#search-results');
  const hint = document.querySelector<HTMLElement>('#search-hint');
  const entries: SearchEntry[] = JSON.parse(dialog?.dataset.entries || '[]');
  const normalize = (value: string) => value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();

  function render(query = '') {
    if (!results || !hint) return;
    const term = normalize(query.trim());
    const filtered = term
      ? entries.filter((entry) => normalize(`${entry.title} ${entry.description} ${entry.keywords} ${entry.category}`).includes(term))
      : entries.filter((_, index) => [0, 1, 3, 5, 7, 12].includes(index));
    hint.textContent = term ? `${filtered.length} ${filtered.length === 1 ? 'resultado' : 'resultados'}` : 'Sugerencias para empezar';
    results.replaceChildren();
    if (!filtered.length) {
      const empty = document.createElement('div');
      empty.className = 'empty-search';
      empty.innerHTML = '<strong>Parece que hoy no nos toca esa aula.</strong><span>Prueba con otra búsqueda: “inscripciones”, “podcast” o “historia”.</span>';
      results.append(empty);
      return;
    }
    filtered.forEach((entry) => {
      const link = document.createElement('a');
      link.href = entry.url;
      link.className = 'search-result';
      const body = document.createElement('span');
      const category = document.createElement('small');
      category.textContent = entry.category;
      const title = document.createElement('strong');
      title.textContent = entry.title;
      const description = document.createElement('span');
      description.textContent = entry.description;
      body.append(category, title, description);
      const arrow = document.createElement('span');
      arrow.className = 'result-arrow';
      arrow.setAttribute('aria-hidden', 'true');
      arrow.textContent = '→';
      link.append(body, arrow);
      results.append(link);
    });
  }

  document.querySelectorAll('[data-open-search]').forEach((button) => button.addEventListener('click', () => {
    render(input?.value || '');
    dialog?.showModal();
    document.body.classList.add('dialog-open');
    window.setTimeout(() => input?.focus(), 60);
  }));
  document.querySelector('[data-close-search]')?.addEventListener('click', () => dialog?.close());
  dialog?.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
  dialog?.addEventListener('keydown', (event) => { if (event.key === 'Escape') { event.preventDefault(); dialog.close(); } });
  dialog?.addEventListener('close', () => document.body.classList.remove('dialog-open'));
  input?.addEventListener('input', () => render(input.value));
  render();
</script>

<style>
  .search-dialog { width: 100%; max-width: none; min-height: 100dvh; max-height: none; margin: 0; padding: 0; border: 0; background: var(--surface-page); color: var(--text-primary); opacity: 0; transform: translateY(-10px); transition: opacity 200ms ease-out, transform 200ms ease-out, overlay 200ms allow-discrete, display 200ms allow-discrete; }
  .search-dialog[open] { opacity: 1; transform: translateY(0); }
  @starting-style { .search-dialog[open] { opacity: 0; transform: translateY(-10px); } }
  .search-dialog::backdrop { background: var(--surface-page); }
  .search-shell { width: min(100% - 32px, 920px); margin-inline: auto; padding-block: 24px 64px; }
  .search-top { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: clamp(40px, 8vw, 80px); }
  .search-top p { margin: 0; font-size: .78rem; font-weight: 750; letter-spacing: .1em; text-transform: uppercase; }
  .search-close { width: 44px; height: 44px; display: grid; place-items: center; border: 0; border-radius: 50%; background: var(--surface-muted); color: var(--text-primary); cursor: pointer; transition: transform 180ms ease-out; }
  .search-close:hover { transform: rotate(5deg); }
  .search-field { display: grid; grid-template-columns: auto 1fr; align-items: center; gap: 16px; border-bottom: 2px solid var(--text-primary); padding-bottom: 16px; }
  .search-field input { min-width: 0; border: 0; outline: 0; background: transparent; color: var(--text-primary); font: inherit; font-size: clamp(1.25rem, 4vw, 2.2rem); font-weight: 650; letter-spacing: -.035em; }
  .search-field input::placeholder { color: var(--text-tertiary); opacity: 1; }
  .search-field:focus-within { border-color: var(--accent-secondary); }
  .search-hint { margin: 24px 0 8px; color: var(--text-secondary); font-size: .76rem; font-weight: 650; }
  .search-results { display: grid; }
  .search-results :global(.search-result) { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 16px; padding-block: 20px; border-bottom: 1px solid var(--border-subtle); color: var(--text-primary); text-decoration: none; transition: padding 180ms ease-out, background 180ms ease-out; }
  .search-results :global(.search-result:hover) { padding-inline: 12px; background: var(--surface-muted); }
  .search-results :global(.search-result > span:first-child) { display: grid; gap: 5px; }
  .search-results :global(.search-result small) { color: var(--accent-primary); font-size: .65rem; font-weight: 750; text-transform: uppercase; letter-spacing: .09em; }
  .search-results :global(.search-result strong) { font-size: 1.05rem; }
  .search-results :global(.search-result span span) { color: var(--text-secondary); font-size: .82rem; line-height: 1.55; }
  .search-results :global(.result-arrow) { color: var(--accent-primary); font-size: 1.5rem; }
  .search-results :global(.empty-search) { display: grid; gap: 8px; padding-block: 32px; }
  .search-results :global(.empty-search strong) { font-size: 1.3rem; }
  .search-results :global(.empty-search span) { color: var(--text-secondary); line-height: 1.6; }
  @media (min-width: 768px) { .search-dialog { min-height: auto; height: auto; max-height: 90dvh; width: min(100% - 48px, 1040px); margin: 5vh auto auto; border: 1px solid var(--border-subtle); } .search-dialog::backdrop { background: rgb(30 15 17 / .65); backdrop-filter: blur(6px); } .search-shell { padding-block: 32px 48px; } }
</style>
