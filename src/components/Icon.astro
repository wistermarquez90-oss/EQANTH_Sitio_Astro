---
interface Props {
  name: string;
  size?: number;
  class?: string;
}
const { name, size = 24, class: className = '' } = Astro.props;
---
<svg class={className} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'arrow' && <><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></>}
  {name === 'external' && <><path d="M15 4h5v5"/><path d="m10 14 10-10"/><path d="M18 13v6a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h6"/></>}
  {name === 'search' && <><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></>}
  {name === 'menu' && <><path d="M4 7h16M4 12h16M4 17h16"/></>}
  {name === 'close' && <><path d="m6 6 12 12M18 6 6 18"/></>}
  {name === 'book' && <><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20V4H6.5A2.5 2.5 0 0 0 4 6.5z"/><path d="M4 6.5v13M8 7h8M8 11h6"/></>}
  {name === 'mic' && <><rect x="8" y="3" width="8" height="12" rx="4"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3M8 21h8"/></>}
  {name === 'users' && <><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></>}
  {name === 'compass' && <><circle cx="12" cy="12" r="9"/><path d="m15.5 8.5-2 5-5 2 2-5z"/></>}
  {name === 'heart' && <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8z"/>}
  {name === 'mail' && <><rect x="3" y="5" width="18" height="14" rx="1"/><path d="m3 7 9 6 9-6"/></>}
  {name === 'instagram' && <><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><path d="M17.5 6.5h.01"/></>}
  {name === 'youtube' && <><path d="M22 12s0-4-.5-5.5a2.8 2.8 0 0 0-2-2C18 4 12 4 12 4s-6 0-7.5.5a2.8 2.8 0 0 0-2 2C2 8 2 12 2 12s0 4 .5 5.5a2.8 2.8 0 0 0 2 2C6 20 12 20 12 20s6 0 7.5-.5a2.8 2.8 0 0 0 2-2C22 16 22 12 22 12z"/><path d="m10 9 5 3-5 3z"/></>}
  {name === 'chevron' && <path d="m6 9 6 6 6-6"/>}
  {name === 'play' && <><circle cx="12" cy="12" r="9"/><path d="m10 8 6 4-6 4z"/></>}
  {name === 'calendar' && <><rect x="3" y="5" width="18" height="16" rx="1"/><path d="M16 3v4M8 3v4M3 10h18M8 14h.01M12 14h.01M16 14h.01M8 18h.01M12 18h.01"/></>}
  {name === 'pin' && <><path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0z"/><circle cx="12" cy="10" r="2.5"/></>}
  {name === 'file' && <><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M8 13h8M8 17h6"/></>}
  {name === 'map' && <><path d="m3 6 6-3 6 3 6-3v15l-6 3-6-3-6 3z"/><path d="M9 3v15M15 6v15"/></>}
  {name === 'check' && <path d="m5 12 4 4L19 6"/>}
  {name === 'plus' && <path d="M12 5v14M5 12h14"/>}
</svg>
