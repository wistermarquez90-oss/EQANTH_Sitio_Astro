---
import GridGuides from './GridGuides.astro';
import { asset } from '../utils/paths';
interface Props {
  label: string;
  intro: string;
  image?: string;
  imageAlt?: string;
  caption?: string;
}
const { label, intro, image, imageAlt = '', caption } = Astro.props;
---
<section class:list={["page-hero", { 'with-image': image }]}>
  <GridGuides />
  <div class="page-hero-inner">
    <div class="page-hero-copy">
      <p class="section-label">{label}</p>
      <h1><slot name="title" /></h1>
      <p class="page-hero-intro">{intro}</p>
      <slot name="actions" />
    </div>
    {image && <figure class="page-hero-media">
      <img src={asset(image)} alt={imageAlt} width="1200" height="720" />
      {caption && <figcaption>{caption}</figcaption>}
    </figure>}
  </div>
</section>

<style>
  .page-hero { position: relative; overflow: hidden; border-bottom: 1px solid var(--border-subtle); }
  .page-hero-inner { position: relative; z-index: 1; width: min(100% - 32px, var(--container)); margin-inline: auto; padding-block: clamp(56px, 8vw, 104px); display: grid; gap: 40px; }
  .page-hero-copy { align-self: center; }
  .page-hero h1 { max-width: 13ch; margin: 18px 0 24px; font-size: clamp(2.7rem, 8vw, 6.7rem); line-height: .98; letter-spacing: -.065em; text-wrap: balance; }
  .page-hero-intro { max-width: 57ch; margin: 0; color: var(--text-secondary); font-size: clamp(1rem, 1.8vw, 1.18rem); line-height: 1.7; }
  .page-hero-copy :global(.hero-actions) { margin-top: 32px; }
  .page-hero-media { position: relative; margin: 0; min-height: 260px; overflow: hidden; background: var(--surface-muted); }
  .page-hero-media img { width: 100%; height: 100%; min-height: 260px; object-fit: cover; }
  .page-hero-media figcaption { position: absolute; left: 0; bottom: 0; max-width: 90%; padding: 12px 16px; background: var(--surface-page); color: var(--text-secondary); font-size: .68rem; font-weight: 600; }
  @media (min-width: 900px) {
    .with-image .page-hero-inner { grid-template-columns: repeat(12, 1fr); align-items: stretch; }
    .with-image .page-hero-copy { grid-column: 1 / span 7; padding-right: 24px; }
    .with-image .page-hero-media { grid-column: 8 / -1; min-height: 480px; }
    .with-image .page-hero-media img { min-height: 480px; }
    .page-hero:not(.with-image) .page-hero-copy { display: grid; grid-template-columns: repeat(12, 1fr); column-gap: 24px; align-items: end; }
    .page-hero:not(.with-image) .section-label { grid-column: 1 / -1; }
    .page-hero:not(.with-image) h1 { grid-column: 1 / span 8; margin-bottom: 0; }
    .page-hero:not(.with-image) .page-hero-intro { grid-column: 9 / -1; padding-bottom: 8px; }
    .page-hero:not(.with-image) .hero-actions { grid-column: 9 / -1; }
  }
</style>
